generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  name             String
  password         String
  role             String          @default("user")
  image            String?
  avatarUrl        String?
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  articles         Article[]
  bakeryReviews    BakeryReview[]
  cart             Cart?
  receivedMessages Message[]       @relation("receivedMessages")
  sentMessages     Message[]       @relation("sentMessages")
  orders           Order[]
  productReviews   ProductReview[]
  reservations     Reservation[]
}

model Product {
  id          String          @id @default(cuid())
  name        String          @unique
  description String
  price       Float
  category    String
  imageUrl    String?
  isPromo     Boolean         @default(false)
  promoPrice  Float?
  isAvailable Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     ProductReview[]
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  totalAmount     Float
  status          String      @default("pending")
  pickupTime      DateTime?
  address         String?
  deliveryAddress String?
  deliveryTime    String?
  deliveryStatus  String      @default("pending")
  adminNote       String?
  paymentStatus   String      @default("pending")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  priceAtTime Float
  order       Order   @relation(fields: [orderId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
}

model Reservation {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime
  time            String
  numberOfPeople  Int
  specialRequests String?
  status          String   @default("pending")
  adminNote       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model BakerySettings {
  id             String   @id @default(cuid())
  bakeryName     String   @default("Ma Boulangerie")
  logoUrl        String?
  contactEmail   String?
  contactPhone   String?
  address        String?
  openingHours   String?
  categoryOrder  Json?
  heroImage      String?
  exchangeRate   Float?   @default(2300)
  primaryColor   String   @default("#fbbf24")
  secondaryColor String   @default("#78350f")
  updatedAt      DateTime @updatedAt
  workEnd        String?  @default("17:00")
  workStart      String?  @default("08:00")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  receiver   User     @relation("receivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("sentMessages", fields: [senderId], references: [id])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Article {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  content         String
  excerpt         String?
  imageMain       String?
  imagesSecondary Json?
  publishedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  views           Int       @default(0)
  likes           Int       @default(0)
  authorId        String
  author          User      @relation(fields: [authorId], references: [id])
  comments        Comment[]
}

model Comment {
  id         String   @id @default(cuid())
  authorName String
  content    String
  articleId  String
  createdAt  DateTime @default(now())
  article    Article  @relation(fields: [articleId], references: [id])
}

model PageView {
  id        String   @id @default(cuid())
  visitorId String
  page      String?
  createdAt DateTime @default(now())
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?
  image     String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String
  email          String?      @unique
  phone          String?
  position       String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  department     String?
  image          String?
  qrCode         String       @unique
  scheduledEnd   String?      @default("17:00")
  scheduledStart String?      @default("08:00")
  attendances    Attendance[]
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  type       String
  timestamp  DateTime @default(now())
  date       DateTime @default(now())
  ipAddress  String?
  location   String?
  createdAt  DateTime @default(now())
  device     String?
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model ProductReview {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  productId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model BakeryReview {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model StockProduct {
  id                String          @id @default(cuid())
  sku               String          @unique
  name              String
  category          String
  imageUrl          String?
  quantity          Int             @default(0)
  unit              String          @default("pièce")
  minStock          Int             @default(5)
  price             Float?
  status            String          @default("disponible")
  manufacturingDate DateTime?
  expirationDate    DateTime?
  updatedAt         DateTime        @updatedAt
  createdAt         DateTime        @default(now())
  purchasePrice     Float?
  stockMovements    StockMovement[]
}

model StockMovement {
  id        String       @id @default(cuid())
  productId String
  type      String
  quantity  Int
  reason    String?
  createdAt DateTime     @default(now())
  product   StockProduct @relation(fields: [productId], references: [id])
}

// Section (point de vente)
model Section {
  id            String           @id @default(cuid())
  name          String           @unique
  password      String           // mot de passe hashé
  description   String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  products      SectionProduct[]
  dailySales    DailySale[]
}

// Produits d'une section
model SectionProduct {
  id          String   @id @default(cuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name        String
  price       Float    // prix de vente
  quantity    Int      @default(0) // quantité pour la journée en cours
  unit        String   @default("pièce")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  saleItems   DailySaleItem[]
}

// Vente journalière (rapport)
model DailySale {
  id          String   @id @default(cuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  date        DateTime @default(now()) // date de la vente (jour)
  totalAmount Float
  totalInitialStock Int   @default(0) // stock total initial (somme des quantités)
  totalItemsSold    Int   @default(0) // quantité totale vendue
  items       DailySaleItem[]
  createdAt   DateTime @default(now())
}

// Ligne de vente journalière
model DailySaleItem {
  id          String         @id @default(cuid())
  dailySaleId String
  dailySale   DailySale      @relation(fields: [dailySaleId], references: [id], onDelete: Cascade)
  productId   String
  product     SectionProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int
  priceAtSale Float          // prix au moment de la vente
  total       Float
}