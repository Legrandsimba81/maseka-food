generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  password          String
  role              String    @default("user")
  resetToken        String?
  resetTokenExpiry  DateTime?
  orders            Order[]
  reservations      Reservation[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Product {
  id          String    @id @default(cuid())
  name        String
  description String
  price       Float
  category    String
  imageUrl    String?
  isAvailable Boolean   @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  totalAmount Float
  status      String      @default("pending")
  pickupTime  DateTime?
  address     String?
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  priceAtTime Float
}

model Reservation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  date           DateTime
  time           String
  numberOfPeople Int
  specialRequests String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BakerySettings {
  id            String   @id @default(cuid())
  bakeryName    String   @default("Ma Boulangerie")
  logoUrl       String?
  contactEmail  String?
  contactPhone  String?
  address       String?
  openingHours  String?
  primaryColor  String   @default("#fbbf24")
  secondaryColor String  @default("#78350f")
  updatedAt     DateTime @updatedAt
}
